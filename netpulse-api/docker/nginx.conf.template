server {
    listen ${PORT};
    root /var/www/public;
    index index.php;
    client_max_body_size 20M;

    # Dynamically reflect the origin if it matches an allowed pattern
    set $allow_origin "";
    if ($http_origin ~ "\.vercel\.app$") {
        set $allow_origin $http_origin;
    }
    if ($http_origin ~ "^http://localhost") {
        set $allow_origin $http_origin;
    }

    location / {
        if ($request_method = OPTIONS) {
            add_header 'Access-Control-Allow-Origin'  $allow_origin;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, X-Requested-With';
            add_header 'Access-Control-Max-Age' 86400;
            return 204;
        }
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;

        # Strip Laravel's CORS headers to prevent duplicates
        fastcgi_hide_header 'Access-Control-Allow-Origin';
        fastcgi_hide_header 'Access-Control-Allow-Methods';
        fastcgi_hide_header 'Access-Control-Allow-Headers';
        fastcgi_hide_header 'Access-Control-Max-Age';

        # Re-add with the correct dynamic origin
        add_header 'Access-Control-Allow-Origin'  $allow_origin always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, X-Requested-With' always;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
